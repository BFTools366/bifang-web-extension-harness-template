# 团队身份和权限查询复用同一领域服务；ID 全部为十进制字符串。
scalar TeamTimestamp
type TeamMember {
 id: ID!
 accountId: ID!
 organizationId: ID!
 displayName: String!
 role: String!
 status: String!
 version: Int!
 roleIds: [ID!]!
 roleNames: [String!]!
 canRemove: Boolean!
 canAssignRoles: Boolean!
 permissions: [String!]!
}
type TeamInvitation {
 id: ID!
 organizationId: ID!
 organizationName: String!
 accountId: ID!
 status: String!
 version: Int!
 expiresAt: TeamTimestamp!
}
type TeamMemberPage { items: [TeamMember!]!, total: Int! }
type TeamInvitationPage { items: [TeamInvitation!]!, total: Int! }
type TeamRole { canManage: Boolean!, id: ID!, organizationId: ID!, code: String!, name: String!, protected: Boolean!, version: Int!, permissions: [String!]! }
type TeamRolePage { items: [TeamRole!]!, total: Int! }
type Query {
 teamMembers(organizationId: ID!, page: Int!, pageSize: Int!): TeamMemberPage!
 teamInvitations(organizationId: ID, page: Int!, pageSize: Int!): TeamInvitationPage!
 teamPermissionCatalog(organizationId: ID!): [String!]!
 teamAssignableRoles(organizationId: ID!): TeamRolePage!
 teamRoles(organizationId: ID!, page: Int!, pageSize: Int!): TeamRolePage!
}
