{
  "name": "bifang-web-harness-template",
  "version": "0.1.0",
  "private": true,
  "description": "以智能体为首要使用者的 TypeScript Harness 模板，生成 React Web 或 Plasmo Chrome MV3 / Firefox MV2 扩展。",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.8.1"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "harness": "tsx .harness/tooling/cli.ts",
    "instantiate": "tsx scripts/instantiate.ts",
    "validate:harness": "tsx scripts/validate-harness.ts",
    "comments:check": "tsx .harness/tooling/comment-policy.ts check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && pnpm comments:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "i18next": "26.4.2",
    "jotai": "3.0.1",
    "jsdom": "30.1.1",
    "ky": "2.1.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
