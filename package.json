{
  "name": "bifang-web-harness-template",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript Harness template for either a React web app or a Plasmo Chrome extension.",
  "type": "module",
  "engines": {
    "node": ">=26.10.0",
    "pnpm": ">=12.8.1"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "harness": "tsx .harness/tooling/cli.ts",
    "instantiate": "tsx scripts/instantiate.ts",
    "validate:harness": "tsx scripts/validate-harness.ts",
    "comments:check": "tsx .harness/tooling/comment-policy.ts check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && pnpm comments:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
